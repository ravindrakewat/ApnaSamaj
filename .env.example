# Apna Samaj Monorepo — Local Environment Variables Template
# Copy this file to .env for local monorepo development.
# NEVER commit real credentials or private keys to version control.

# Server & Client Ports
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database Connection (PostgreSQL)
# For local development with PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apnasamaj_dev?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apnasamaj_dev?schema=public"

# Authentication Secrets (Replace with high-entropy secret >= 32 chars)
JWT_ACCESS_SECRET="dev_access_token_secret_placeholder_min_32_characters"

# Super Admin Seed Account
BOOTSTRAP_ADMIN_PHONE="+919876543210"
BOOTSTRAP_ADMIN_PASSWORD="replace_with_initial_superadmin_password"
BOOTSTRAP_ADMIN_NAME="Apna Samaj Admin"

# Supabase Storage Configuration (Optional for local avatar/media storage)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"

# Firebase Cloud Messaging (FCM) Configuration (Required for real mobile push notifications)
# FIREBASE_SERVICE_ACCOUNT_PATH="./apps/api/firebase-service-account.json"
