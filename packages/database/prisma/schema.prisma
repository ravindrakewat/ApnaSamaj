datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  SUPER_ADMIN
  COMMUNITY_ADMIN
  MODERATOR
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum PostType {
  GENERAL
  ANNOUNCEMENT
  EVENT
}

enum PostAppealStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum NotificationType {
  POST_LIKE
  POST_COMMENT
  GROUP_ROLE_UPDATE
  GROUP_MEMBER_REMOVED
  ACCOUNT_STATUS_UPDATE
  POST_MODERATED
  MATRIMONIAL_INTEREST_RECEIVED
  MATRIMONIAL_INTEREST_ACCEPTED
  MATRIMONIAL_PROFILE_APPROVED
  MATRIMONIAL_PROFILE_REJECTED
  MATRIMONIAL_PROFILE_SUSPENDED
  MATRIMONIAL_DOCUMENT_APPROVED
  MATRIMONIAL_DOCUMENT_REJECTED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum MatrimonialProfileStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  HIDDEN
  SUSPENDED
}

enum MatrimonialDocumentType {
  GOVERNMENT_ID
  EDUCATION_PROOF
  OCCUPATION_PROOF
  OTHER
}

enum MatrimonialDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatrimonialReportReason {
  FAKE_PROFILE
  INCORRECT_INFORMATION
  MISLEADING_PHOTOS
  SUSPICIOUS_ACTIVITY
  HARASSMENT
  OTHER
}

enum MatrimonialReportStatus {
  PENDING
  UNDER_INVESTIGATION
  RESOLVED
  DISMISSED
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum ManglikStatus {
  MANGLIK
  NON_MANGLIK
  ANSHIK
  DONT_KNOW
}

enum EmploymentSector {
  PRIVATE_SECTOR
  GOVERNMENT_PSU
  BUSINESS_SELF_EMPLOYED
  DEFENSE
  NOT_WORKING
}

enum FamilyType {
  NUCLEAR
  JOINT
}

enum FamilyValues {
  TRADITIONAL
  MODERATE
  LIBERAL
}

enum DietType {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
  JAIN
}

enum HabitFrequency {
  NO
  YES
  OCCASIONALLY
}

enum MatrimonialInterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

// --------------------------------------------------------
// AUTHENTICATION & USER CREDENTIALS
// --------------------------------------------------------

model User {
  id              String     @id @default(uuid())
  phone           String     @unique // Normalized E.164: +91XXXXXXXXXX
  passwordHash    String // Strictly non-nullable in Phase 1
  isPhoneVerified Boolean    @default(false) // Defaults to false in Phase 1
  role            Role       @default(MEMBER)
  status          UserStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile                      Profile?
  refreshTokens                RefreshToken[]
  passwordResetTokens          PasswordResetToken[]
  createdGroups                Group[]                         @relation("GroupCreator")
  groupMemberships             GroupMember[]
  posts                        Post[]                          @relation("PostAuthor")
  comments                     Comment[]                       @relation("CommentAuthor")
  postLikes                    PostLike[]
  postViews                    PostView[]
  authoredAuditLogs            AuditLog[]                      @relation("AuditActor")
  receivedNotifications        Notification[]                  @relation("NotificationRecipient")
  triggeredNotifications       Notification[]                  @relation("NotificationActor")
  sentChatMessages             ChatMessage[]                   @relation("SentChatMessages")
  directConversationsAsUserOne DirectConversation[]            @relation("DirectConversationsAsUserOne")
  directConversationsAsUserTwo DirectConversation[]            @relation("DirectConversationsAsUserTwo")
  directChatParticipations     DirectConversationParticipant[] @relation("DirectChatParticipants")
  sentDirectMessages           DirectMessage[]                 @relation("SentDirectMessages")
  matrimonialProfile           MatrimonialProfile?
  sentMatrimonialInterests     MatrimonialInterest[]           @relation("SentMatrimonialInterests")
  receivedMatrimonialInterests MatrimonialInterest[]           @relation("ReceivedMatrimonialInterests")
  approvedMatrimonialProfiles  MatrimonialProfile[]            @relation("MatrimonialProfileApprover")
  authoredPostAppeals          PostAppeal[]                    @relation("PostAppealAuthor")
  reviewedPostAppeals          PostAppeal[]                    @relation("PostAppealReviewer")
  verifiedMatrimonialProfiles  MatrimonialProfile[]            @relation("MatrimonialProfileVerifier")
  reviewedMatrimonialDocuments MatrimonialDocument[]           @relation("MatrimonialDocumentReviewer")
  reportedMatrimonialProfiles  MatrimonialReport[]             @relation("MatrimonialReportReporter")
  resolvedMatrimonialReports   MatrimonialReport[]             @relation("MatrimonialReportResolver")
  blockedMatrimonialUsers      MatrimonialBlock[]              @relation("MatrimonialBlocker")
  blockedByMatrimonialUsers    MatrimonialBlock[]              @relation("MatrimonialBlockedUser")
  devicePushTokens             DevicePushToken[]
  notificationPreference       NotificationPreference?
  notificationLogs             NotificationLog[]
  chatMessageReactions         ChatMessageReaction[]
  directMessageReactions       DirectMessageReaction[]

  @@index([role])
  @@index([status])
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String // Single source of truth for member name
  gender      Gender?
  dateOfBirth DateTime?
  bio         String?
  avatarUrl   String?
  city        String?
  state       String?
  subCaste    String?
  gotra       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([city, state])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 hash of the random refresh token
  familyId   String    @default(uuid()) // Token family for rotation & replay detection
  userAgent  String?
  ipAddress  String?
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime? // Timestamp when revoked or rotated
  replacedBy String? // SHA-256 hash of the replacement token
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 hash of the one-time reset token
  expiresAt DateTime // Fixed 1-hour expiration
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// --------------------------------------------------------
// COMMUNITY GROUPS
// --------------------------------------------------------

model Group {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  coverUrl    String?
  privacy     GroupPrivacy @default(PUBLIC)
  createdById String
  creator     User         @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members      GroupMember[]
  posts        Post[]
  chatMessages ChatMessage[]

  @@index([privacy])
  @@index([createdById])
}

model GroupMember {
  id       String          @id @default(uuid())
  groupId  String
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// --------------------------------------------------------
// SOCIAL FEED (POSTS, MEDIA, COMMENTS, LIKES)
// --------------------------------------------------------

model Post {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  type      PostType @default(GENERAL)
  title     String?
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media    PostMedia[]
  comments Comment[]
  likes    PostLike[]
  views    PostView[]

  @@index([authorId])
  @@index([groupId])
  @@index([createdAt(sort: Desc)])
}

model PostMedia {
  id        String    @id @default(uuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaType MediaType @default(IMAGE)
  url       String
  thumbnail String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId]) // Prevents duplicate likes from the same user
  @@index([userId])
}

model PostView {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId]) // Enforces deduplication: each member views a post at most once
  @@index([userId])
  @@index([postId])
}

// --------------------------------------------------------
// ADMINISTRATIVE AUDIT LOGGING
// --------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String // e.g. "USER_STATUS_UPDATE", "USER_ROLE_UPDATE"
  targetType String // e.g. "USER"
  targetId   String // The ID of the affected user or entity
  details    Json? // Context, e.g. { previousStatus: "ACTIVE", newStatus: "SUSPENDED", reason: "..." }
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

// --------------------------------------------------------
// IN-APP NOTIFICATIONS
// --------------------------------------------------------

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  title       String
  message     String
  entityType  String?
  entityId    String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt(sort: Desc)])
}

// --------------------------------------------------------
// DEVICE PUSH TOKENS & NOTIFICATION PREFERENCES (FCM)
// --------------------------------------------------------

model DevicePushToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  isActive   Boolean        @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, isActive])
  @@index([token])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalMessages Boolean  @default(true)
  groupMessages    Boolean  @default(true)
  matrimonial      Boolean  @default(true)
  likes            Boolean  @default(true)
  comments         Boolean  @default(true)
  announcements    Boolean  @default(true)
  communityUpdates Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model NotificationLog {
  id        String                     @id @default(uuid())
  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  status    NotificationDeliveryStatus @default(PENDING)
  errorCode String?
  createdAt DateTime                   @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([category, status])
}

// --------------------------------------------------------
// REAL-TIME GROUP CHAT
// --------------------------------------------------------

model ChatMessage {
  id               String                @id @default(uuid())
  groupId          String
  group            Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User                  @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content          String
  clientMessageId  String?
  replyToMessageId String?
  replyTo          ChatMessage?          @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          ChatMessage[]         @relation("ChatMessageReplies")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  attachments ChatAttachment[]
  reactions   ChatMessageReaction[]

  @@unique([groupId, senderId, clientMessageId])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([replyToMessageId])
}

// --------------------------------------------------------
// --------------------------------------------------------
// DIRECT ONE-TO-ONE MESSAGING
// --------------------------------------------------------

model DirectConversation {
  id        String   @id @default(uuid())
  userOneId String
  userOne   User     @relation("DirectConversationsAsUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwoId String
  userTwo   User     @relation("DirectConversationsAsUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([updatedAt(sort: Desc)])
}

model DirectConversationParticipant {
  id             String             @id @default(uuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation("DirectChatParticipants", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model DirectMessage {
  id               String                 @id @default(uuid())
  conversationId   String
  conversation     DirectConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User                   @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content          String
  clientMessageId  String?
  replyToMessageId String?
  replyTo          DirectMessage?         @relation("DirectMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          DirectMessage[]        @relation("DirectMessageReplies")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  attachments ChatAttachment[]
  reactions   DirectMessageReaction[]

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([replyToMessageId])
}

// --------------------------------------------------------
// CHAT MEDIA ATTACHMENTS (PERSONAL & GROUP CHAT)
// --------------------------------------------------------

model ChatAttachment {
  id              String         @id @default(uuid())
  chatMessageId   String?
  chatMessage     ChatMessage?   @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  directMessageId String?
  directMessage   DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  type            MediaType      @default(IMAGE)
  fileName        String
  mimeType        String
  fileSizeBytes   Int
  storagePath     String
  duration        Int?
  createdAt       DateTime       @default(now())

  @@index([chatMessageId])
  @@index([directMessageId])
}

// --------------------------------------------------------
// CHAT MESSAGE REACTIONS (PERSONAL & GROUP CHAT)
// --------------------------------------------------------

model ChatMessageReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model DirectMessageReaction {
  id        String        @id @default(uuid())
  messageId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime      @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

// MATRIMONIAL MODULE
// --------------------------------------------------------

model MatrimonialProfile {
  id              String                   @id @default(uuid())
  userId          String                   @unique
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          MatrimonialProfileStatus @default(DRAFT)
  rejectionReason String?

  // Physical & Community (complements canonical Profile: fullName, gender, dob, city, state, subCaste, gotra)
  maritalStatus MaritalStatus
  heightCm      Int // Height in centimeters (e.g. 175)
  weightKg      Int? // Optional weight in kg
  motherTongue  String        @default("Hindi")
  religion      String        @default("Hindu")
  caste         String? // Community/Samaj lineage
  subCaste      String? // Can supplement Profile subCaste
  gotra         String? // Gotra
  manglik       ManglikStatus @default(DONT_KNOW)

  // Astrological / Horoscope (optional)
  birthTime String? // e.g. "14:30"
  birthCity String?
  rashi     String? // Moon sign / Zodiac
  nakshatra String? // Birth star

  // Education & Career
  highestEducation String // e.g. "B.Tech in Computer Science", "MBA", "MBBS"
  educationDetails String? // College / University / Additional degrees
  employedIn       EmploymentSector @default(PRIVATE_SECTOR)
  occupation       String // e.g. "Software Engineer", "Bank Manager"
  companyName      String? // Employer (optional)
  annualIncome     String // Bracket or range: e.g. "10-15 Lakhs", "15-25 Lakhs"
  workCity         String?
  workState        String?
  workCountry      String           @default("India")

  // Family Background
  familyType        FamilyType   @default(NUCLEAR)
  familyValues      FamilyValues @default(TRADITIONAL)
  fatherName        String?
  fatherOccupation  String?
  motherName        String?
  motherOccupation  String?
  brothersCount     Int          @default(0)
  brothersMarried   Int          @default(0)
  sistersCount      Int          @default(0)
  sistersMarried    Int          @default(0)
  familyNativePlace String? // Hometown / Ancestral village
  aboutFamily       String?

  // Lifestyle
  diet     DietType       @default(VEGETARIAN)
  smoking  HabitFrequency @default(NO)
  drinking HabitFrequency @default(NO)

  // Personal Narratives
  aboutMe             String?
  partnerExpectations String?

  // Moderation & Tracking
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("MatrimonialProfileApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("MatrimonialProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photos            MatrimonialPhoto[]
  partnerPreference MatrimonialPartnerPreference?
  documents         MatrimonialDocument[]
  reports           MatrimonialReport[]

  @@index([status])
  @@index([maritalStatus])
  @@index([heightCm])
  @@index([diet])
  @@index([manglik])
}

model MatrimonialPartnerPreference {
  id        String             @id @default(uuid())
  profileId String             @unique
  profile   MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  minAge          Int             @default(18)
  maxAge          Int             @default(45)
  minHeightCm     Int             @default(140)
  maxHeightCm     Int             @default(210)
  maritalStatuses MaritalStatus[] @default([])
  manglik         ManglikStatus?
  diet            DietType?

  preferredEducations  String[] @default([])
  preferredOccupations String[] @default([])
  preferredCities      String[] @default([])
  preferredStates      String[] @default([])
  minIncome            String?
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MatrimonialPhoto {
  id         String             @id @default(uuid())
  profileId  String
  profile    MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url        String
  order      Int                @default(0)
  isPrimary  Boolean            @default(false)
  isApproved Boolean            @default(true)
  createdAt  DateTime           @default(now())

  @@index([profileId])
  @@index([profileId, isPrimary])
}

model MatrimonialInterest {
  id          String                    @id @default(uuid())
  senderId    String
  sender      User                      @relation("SentMatrimonialInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                      @relation("ReceivedMatrimonialInterests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      MatrimonialInterestStatus @default(PENDING)
  message     String? // Optional note with interest
  respondedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
}

model MatrimonialDocument {
  id              String                    @id @default(uuid())
  profileId       String
  profile         MatrimonialProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  documentType    MatrimonialDocumentType
  documentName    String
  storagePath     String
  fileSize        Int
  mimeType        String
  status          MatrimonialDocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?                     @relation("MatrimonialDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([profileId])
  @@index([status])
}

model MatrimonialReport {
  id                String                  @id @default(uuid())
  reporterId        String
  reporter          User                    @relation("MatrimonialReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedProfileId String
  reportedProfile   MatrimonialProfile      @relation(fields: [reportedProfileId], references: [id], onDelete: Cascade)
  reason            MatrimonialReportReason
  explanation       String?
  status            MatrimonialReportStatus @default(PENDING)
  adminNotes        String?
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?                   @relation("MatrimonialReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([reporterId, reportedProfileId])
  @@index([reportedProfileId])
  @@index([status])
}

model MatrimonialBlock {
  id            String   @id @default(uuid())
  blockerId     String
  blocker       User     @relation("MatrimonialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("MatrimonialBlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
  @@index([blockedUserId])
}

// --------------------------------------------------------
// MEMBER MODERATION APPEALS
// --------------------------------------------------------

model PostAppeal {
  id          String           @id @default(uuid())
  postId      String // Historical post UUID identifier; post is physically deleted upon moderation takedown
  authorId    String?
  author      User?            @relation("PostAppealAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reason      String
  details     String?
  status      PostAppealStatus @default(PENDING)
  moderatorId String?
  moderator   User?            @relation("PostAppealReviewer", fields: [moderatorId], references: [id], onDelete: SetNull)
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([authorId])
  @@index([postId])
  @@index([status, createdAt(sort: Desc)])
}
