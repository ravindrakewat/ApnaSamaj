# Apna Samaj Mobile Environment Configuration
# API Base URL (Backend runs on port 4000 by default)
# For Web testing on PC:
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# For Physical Android Phone testing over Wi-Fi (replace with your PC's IP):
# EXPO_PUBLIC_API_URL=http://192.168.29.64:4000/api/v1

# Default Community Tenant Slug (e.g. kewat)
EXPO_PUBLIC_DEFAULT_COMMUNITY_SLUG=kewat

