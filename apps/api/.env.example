# Apna Samaj API Environment Variables Example
# Duplicate this file to .env for local development

PORT=4000
NODE_ENV=development

# Allowed Origins (CORS & CSRF Origin checks)
CLIENT_URL=http://localhost:5176
ADMIN_URL=http://localhost:5175

# Database Connection (Placeholder - do NOT use real credentials)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apnasamaj_dev?schema=public"

# Authentication Secrets (Replace with secure random string >= 32 characters in production)
# Note: Refresh tokens are high-entropy opaque random strings (not JWTs); their SHA-256 hash is verified against the database.
JWT_ACCESS_SECRET="dev_access_token_secret_placeholder_min_32_characters"

# Bootstrap Initial Super Admin (Used only by npm run db:seed)
BOOTSTRAP_ADMIN_PHONE="+919876543210"
BOOTSTRAP_ADMIN_PASSWORD="replace_with_initial_superadmin_password"
